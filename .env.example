DATABASE_URL=postgresql://skope_admin:skope_pass_secure@localhost:5432/skope_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=skope_chunks_v1
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Use CPUExecutionProvider when CUDA is unavailable. CUDA requires the optional
# database/requirements-gpu-windows.txt packages on the Windows host.
EMBEDDING_EXECUTION_PROVIDER=CPUExecutionProvider
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base
CORPUS_VERSION=skope-corpus-v1

# Use dev locally. Switch to firebase only after credentials are configured.
AUTH_MODE=dev
DEV_AUTH_TOKEN=replace-this-local-token
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.5-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=8
LLM_TOTAL_BUDGET_SECONDS=10
LLM_MAX_RETRIES=1
LLM_CIRCUIT_BREAKER_FAILURES=2
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
RERANKER_CANDIDATE_LIMIT=12
RERANKER_ENABLED=true
PREWARM_MODELS=true
CHAT_RATE_LIMIT_PER_MINUTE=20
